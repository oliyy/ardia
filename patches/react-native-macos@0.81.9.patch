+  NSNumber *rootTag = shadowView.rootView.reactTag;
+  ArdiaPresentationFreezeRoot *root = _presentationFreezeRoots[rootTag];
+  NSMutableDictionary<NSNumber *, NSNumber *> *gates = [NSMutableDictionary new];
+  for (RCTShadowView *pinned in root.pins) {
+    BOOL related = NO;
+    for (RCTShadowView *node = pinned; node != nil && !related; node = node.superview) {
+      related = node == shadowView;
+    }
+    for (RCTShadowView *node = shadowView; node != nil && !related; node = node.superview) {
+      related = node == pinned;
+    }
+    NSNumber *gate = related ? [root.pins objectForKey:pinned] : nil;
+    if (gate != nil) {
+      gates[gate] = root.generations[gate] ?: @0;
+    }
+  }
+  if (gates.count == 0) {
+    return NO;
+  }
+  [self ardia_thawRoot:rootTag generations:gates reason:reason];
+  return YES;
+}

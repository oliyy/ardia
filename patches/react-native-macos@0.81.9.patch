+- (BOOL)ardia_freezeThawAroundReactTag:(NSNumber *)reactTag reason:(NSString *)reason
+{
+  if (_presentationFrozenRoots == 0) {
+    return NO;
+  }
+  RCTShadowView *shadowView = _shadowViewRegistry[reactTag];
+  if (shadowView == nil) {
+    return NO;

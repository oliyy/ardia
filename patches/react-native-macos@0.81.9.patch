+  if (YGNodeStyleGetPositionType(_yogaNode) != YGPositionTypeAbsolute) {
+    *reason = @"target is not absolutely positioned";
+    return nil;
+  }
+  RCTShadowView *basis = parent;
+  if (_ntpRole == ArdiaNtpLayoutRoleCommandBar) {
+    if (parent->_ntpRole != ArdiaNtpLayoutRoleNone || parent.ntpLayoutBasis != nil) {
+      *reason = @"unsupported nesting";
+      return nil;
+    }
+    basis = parent.superview;
+    if (basis == nil || YGNodeGetOwner(parent.yogaNode) != basis.yogaNode) {
+      *reason = @"Yoga owner is not the React parent";
+      return nil;
+    }
+    if (!ArdiaNtpLayoutFillsBasis(parent.yogaNode, basis.yogaNode)) {

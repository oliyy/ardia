+- (void)ardia_requestThawGenerations:(NSDictionary<NSNumber *, NSNumber *> *)generations
+                                root:(NSNumber *)rootTag
+                              serial:(NSNumber *)serial
+                              reason:(NSString *)reason
+{
+  RCTExecuteOnUIManagerQueue(^{
+    ArdiaPresentationFreezeRoot *root = self->_presentationFreezeRoots[rootTag];
+    if (root == nil || root.serial != serial.unsignedIntegerValue) {
+      return;
+    }
+    const BOOL unpinned = [self ardia_thawRoot:rootTag generations:generations reason:reason];
+    if ((unpinned || self->_pendingUIBlocks.count > 0) && !self->_presentationBatchPending && ![self->_bridge isLoading]) {
+      [self _layoutAndMount];
+    }
+  });

+    if (frozen && !child.presentationFrozen) {
+      child.presentationFrozen = YES;
+      ArdiaPresentationFreezeMark(child.reactSubviews);
+    } else if (!frozen && child.presentationFrozen) {
+      [self ardia_freezeRelease:@[ child ] root:root thawed:thawed];
+    }
+  }
+  [self ardia_freezeForgetReleased:thawed root:root];
+  [self ardia_freezeSettleRoot:root wasFrozen:wasFrozen];
+  if (thawed.count > 0) {
+    [self ardia_freezeNotifyThaw:rootTag serial:root.serial generations:thawed disabled:NO];
+  }

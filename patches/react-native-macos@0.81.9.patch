+static BOOL RCTViewDisplaysOnlyThroughDisplayLayer(Class viewClass)
+{
+  static NSMapTable<Class, NSNumber *> *answers;
+  if (answers == nil) {
+    answers = [NSMapTable strongToStrongObjectsMapTable];
+  }
+  NSNumber *answer = [answers objectForKey:viewClass];
+  if (answer == nil) {
+    const SEL selectors[] = {
+        @selector(displayLayer:),
+        @selector(updateLayer),
+        @selector(drawRect:),
+        @selector(wantsUpdateLayer),
+        @selector(makeBackingLayer),
+        @selector(drawLayer:inContext:),
+    };
+    BOOL plain = YES;
+    for (size_t index = 0; index < sizeof(selectors) / sizeof(selectors[0]); index++) {
+      plain = plain &&
+          class_getMethodImplementation(viewClass, selectors[index]) ==
+              class_getMethodImplementation([RCTView class], selectors[index]);
+    }
+    answer = @(plain);
+    [answers setObject:answer forKey:viewClass];
+  }
+  return answer.boolValue;

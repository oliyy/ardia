+- (BOOL)ardia_thawGenerationsSynchronously:(NSDictionary<NSNumber *, NSNumber *> *)generations
+                                      root:(NSNumber *)rootTag
+                                    serial:(NSNumber *)serial
+{
+  RCTAssertMainQueue();
+  if (rootTag == nil) {
+    return NO;
+  }
+  if (_drainingMainQueueMounts || RCTIsPseudoUIManagerQueue()) {
+    [self ardia_requestThawGenerations:generations root:rootTag serial:serial reason:@"main-async"];
+    return NO;
+  }
+  ArdiaPresentationLayoutWaiter *waiter = [ArdiaPresentationLayoutWaiter new];
+  RCTExecuteOnUIManagerQueue(^{
+    ArdiaPresentationFreezeRoot *root = self->_presentationFreezeRoots[rootTag];
+    if (root == nil || root.serial != serial.unsignedIntegerValue) {
+      dispatch_semaphore_signal(waiter.semaphore);
+      return;
+    }
+    if (![self ardia_thawRoot:rootTag generations:generations reason:@"main-sync"]) {
+      dispatch_semaphore_signal(waiter.semaphore);
+      if (self->_pendingUIBlocks.count > 0 && !self->_presentationBatchPending && ![self->_bridge isLoading]) {
+        [self _layoutAndMount];
+      }
+      return;
+    }
+    waiter.thawed = YES;
+    [self->_presentationLayoutWaiters addObject:waiter];
+    if (!self->_presentationBatchPending && ![self->_bridge isLoading]) {
+      [self _layoutAndMount];
+    }
+  });
+  if (dispatch_semaphore_wait(waiter.semaphore, dispatch_time(DISPATCH_TIME_NOW, ArdiaPresentationFreezeSyncWaitNs)) != 0 ||
+      !waiter.thawed) {
+    return NO;
+  }
+  [self drainMainQueueMountsThrough:waiter.mount];
+  return YES;
+}

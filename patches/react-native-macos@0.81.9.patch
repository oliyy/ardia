+- (void)ardia_freezeSignalLayoutWaiters
+{
+  if (_presentationLayoutWaiters.count == 0) {
+    return;
+  }
+  uint64_t mount = 0;
+  {
+    std::lock_guard<std::mutex> guard(_mainQueueMountsLock);
+    mount = _lastMainQueueMount;
+  }
+  for (ArdiaPresentationLayoutWaiter *waiter in _presentationLayoutWaiters) {
+    waiter.mount = mount;
+    dispatch_semaphore_signal(waiter.semaphore);
+  }
+  [_presentationLayoutWaiters removeAllObjects];

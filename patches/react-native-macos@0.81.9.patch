+  RCTAssertUIManagerQueue();
+  ArdiaPresentationFreezeRoot *root = rootTag != nil ? _presentationFreezeRoots[rootTag] : nil;
+  if (root == nil) {
+    return NO;
+  }
+  const NSUInteger serial = root.serial;
+  const BOOL wasFrozen = root.pins.count > 0;
+  NSMutableDictionary<NSNumber *, NSNumber *> *thawed = [NSMutableDictionary dictionaryWithDictionary:requested ?: @{}];
+  NSMutableArray<RCTShadowView *> *targets = [NSMutableArray new];
+  for (RCTShadowView *pinned in root.pins) {

+- (void)ardia_freezeThawAllRootsWithReason:(NSString *)reason
+{
+  if (_presentationFreezeRoots.count == 0) {
+    return;
+  }
+  const BOOL disables = [reason isEqualToString:@"layout-animation"];
+  for (NSNumber *rootTag in _presentationFreezeRoots.allKeys) {
+    ArdiaPresentationFreezeRoot *root = _presentationFreezeRoots[rootTag];
+    if (root.pins.count > 0) {
+      [self ardia_thawRoot:rootTag generations:nil reason:reason];
+    } else if (disables && root.sessions.count > 0 && !root.disabled) {
+      root.disabled = YES;
+      [self ardia_freezeNotifyThaw:rootTag serial:root.serial generations:@{} disabled:YES];

+- (void)ardia_freezeRelease:(NSArray<RCTShadowView *> *)shadowViews
+                       root:(ArdiaPresentationFreezeRoot *)root
+                     thawed:(NSMutableDictionary<NSNumber *, NSNumber *> *)thawed
+{

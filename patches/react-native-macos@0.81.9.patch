+static NSArray<NSNumber *> *RCTArdiaEditorComponents(id value)
+{
+  if (![value isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+  NSDictionary *color = value;
+  NSMutableArray<NSNumber *> *components = [NSMutableArray arrayWithCapacity:4];
+  for (NSString *key in @[ @"r", @"g", @"b", @"a" ]) {
+    id channel = color[key];
+    if (![channel isKindOfClass:[NSNumber class]] || CFGetTypeID((__bridge CFTypeRef)channel) == CFBooleanGetTypeID()) {
+      return nil;
+    }
+    double number = [channel doubleValue];
+    if (!std::isfinite(number)) {
+      return nil;
+    }
+    [components addObject:@(number)];
+  }
+  return [components copy];
+}
+
+static NSDictionary<NSString *, NSArray<NSNumber *> *> *RCTArdiaEditorCanonicalPair(id value)
+{
+  if (![value isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+  NSArray<NSNumber *> *light = RCTArdiaEditorComponents(((NSDictionary *)value)[@"light"]);
+  NSArray<NSNumber *> *dark = RCTArdiaEditorComponents(((NSDictionary *)value)[@"dark"]);
+  if (light == nil || dark == nil) {
+    return nil;
+  }
+  return @{@"light" : light, @"dark" : dark};
+}
+
+static NSColor *RCTArdiaEditorColor(NSArray<NSNumber *> *components)
+{
+  return [NSColor colorWithRed:components[0].doubleValue
+                         green:components[1].doubleValue
+                          blue:components[2].doubleValue
+                         alpha:components[3].doubleValue];
+}
+
+static NSColor *RCTArdiaEditorSelectionColor(NSDictionary<NSString *, NSArray<NSNumber *> *> *pair)
+{
+  if (pair == nil) {
+    return nil;
+  }
+  NSColor *light = RCTArdiaEditorColor(pair[@"light"]);
+  NSColor *dark = RCTArdiaEditorColor(pair[@"dark"]);
+  return [NSColor colorWithName:nil
+                dynamicProvider:^NSColor *(NSAppearance *appearance) {
+                  NSAppearanceName match =
+                      [appearance bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]];
+                  return [match isEqualToString:NSAppearanceNameDarkAqua] ? dark : light;
+                }];
+}

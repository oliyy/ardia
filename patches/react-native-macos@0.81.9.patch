+  if (_presentationFrozenRoots == 0) {
+    return NO;
+  }
+  RCTShadowView *shadowView = _shadowViewRegistry[reactTag];
+  if (!(shadowView.presentationFrozen || shadowView.presentationPinned)) {
+    return NO;
+  }
+  NSNumber *rootTag = shadowView.rootView.reactTag;
+  ArdiaPresentationFreezeRoot *root = _presentationFreezeRoots[rootTag];
+  NSMutableDictionary<NSNumber *, NSNumber *> *gates = [NSMutableDictionary new];
+  for (RCTShadowView *node = shadowView; node != nil; node = node.superview) {
+    NSNumber *gate = [root.pins objectForKey:node];
+    if (gate != nil) {
+      gates[gate] = root.generations[gate] ?: @0;
+    }
+  }
+  if (gates.count == 0) {
+    return NO;
+  }
+  [self ardia_thawRoot:rootTag generations:gates reason:reason];
+  return YES;
+}

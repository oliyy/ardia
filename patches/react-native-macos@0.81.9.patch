+    if (!shadowView.presentationFrozen) {
+      continue;
+    }
+    shadowView.presentationFrozen = NO;
+    NSNumber *gate = [root.pins objectForKey:shadowView];
+    if (gate != nil) {
+      [root.pins removeObjectForKey:shadowView];
+      [shadowView ardia_unpinPresentationWidth];
+      thawed[gate] = root.generations[gate] ?: thawed[gate] ?: @0;
+    }
